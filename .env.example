# No keys required. Model is downloaded once; afterwards works offline.
BACKEND=ollama
MODEL=qwen3:4b-q4_K_M
OLLAMA_URL=http://127.0.0.1:11434
CONTEXT_SIZE=4096
MAX_OUTPUT_TOKENS=1000
HISTORY_CHARS=1800
LLM_TIMEOUT=180
